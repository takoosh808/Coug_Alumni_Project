{
  "name": "alumni_full_stack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "db:init": "tsx scripts/init-db.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test:integration": "tsx scripts/run-tests.ts integration",
    "test:functional": "tsx scripts/run-tests.ts functional",
    "test:system": "tsx scripts/run-tests.ts system",
    "test:performance": "tsx scripts/run-tests.ts performance",
    "test:all": "npm run test:unit && tsx scripts/run-tests.ts all",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
